# Copy this file to .env and paste your own key below.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional. Change only if Groq retires this model.
GROQ_MODEL=openai/gpt-oss-120b

# --- Email newsletter (SendGrid) ---
# API key with only the "Mail Send" permission: SendGrid -> Settings -> API Keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
# The sender address you verified in SendGrid (Settings -> Sender Authentication)
EMAIL_FROM=your_verified_sender@example.com
# Who receives the digest. Separate several addresses with commas.
EMAIL_TO=first@example.com,second@example.com
